#!/bin/sh /etc/rc.common
# TapperVPN for OpenWrt / GL.iNet routers.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/tappervpnd
STATE_DIR=/etc/tappervpn
RUN_DIR=/var/run/tappervpn
APPLY=/usr/libexec/tappervpn/apply

start_service() {
	config_load tappervpn
	local enabled port
	config_get_bool enabled main enabled 0
	config_get port main port 41642
	[ "$enabled" = 1 ] || {
		"$APPLY" teardown
		return 0
	}

	mkdir -p "$STATE_DIR" "$RUN_DIR"

	procd_open_instance
	procd_set_param command "$PROG" \
		--state="$STATE_DIR/tappervpnd.state" \
		--statedir="$STATE_DIR" \
		--socket="$RUN_DIR/tappervpnd.sock" \
		--tun=tapper0 \
		--port="$port"
	procd_set_param env TS_NO_LOGS_NO_SUPPORT=true
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# Sign in and set up routing once the daemon is listening.
	"$APPLY" start &
}

stop_service() {
	"$APPLY" teardown
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger tappervpn
}
