
config tappervpn 'main'
	# Set to 1 once login_server (and auth_key for the first sign-in) are filled in.
	option enabled '0'
	# Our control server (Headscale), e.g. https://vpn.example.com
	option login_server ''
	# Pre-auth key from `headscale preauthkeys create`; only needed for the first sign-in.
	option auth_key ''
	# Name shown in the device list; empty means the router's hostname.
	option hostname ''
	# Exit node to send LAN traffic through: its name or 100.x address. Empty = none.
	option exit_node ''
	# Which LAN traffic uses the exit node:
	#   all      every device on the LAN
	#   clients  only the devices in client_mac and the networks in client_zone
	#   domains  only connections to the sites in domain (any device)
	#   none     no LAN traffic; the router just joins the VPN (e.g. to be an exit node)
	option mode 'all'
	# Used by mode 'clients': device MAC addresses, and firewall zones (e.g. 'guest').
	#list client_mac 'aa:bb:cc:dd:ee:ff'
	#list client_zone 'guest'
	# Used by mode 'domains': a site also covers its subdomains.
	#list domain 'espn.com'
	# Mode 'domains': resolve those sites through the exit node, so they see its location.
	option dns_via_exit '1'
	# Reject IPv6 for tunneled traffic so apps fall back to IPv4 right away
	# (the tunnel carries IPv4 only for LAN devices).
	option block_ipv6 '1'
	# Let other VPN devices use this router as their exit node.
	option advertise_exit_node '0'
	# UDP port for peer-to-peer traffic.
	option port '41642'
	# Check GitHub once a day and install signed TapperVPN updates.
	option auto_update '1'
	# Check in with the admin console every minute, so it lists this router and can
	# start an update or a re-apply from there.
	option remote_control '1'
	# The admin console: a DNS-only record pointing at the server's VPN address
	# (looked up through 1.1.1.1), and the address to use if that lookup fails.
	option admin_url 'http://vpnadmin.tapper.co:8096'
	option admin_ip '100.64.0.2'
