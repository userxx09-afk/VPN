    <policy name="NetworkDevices" class="Both" displayName="$(string.NetworkDevices)" explainText="$(string.NetworkDevices_Help)" key="Software\Policies\TapperVPN" valueName="NetworkDevices">
      <parentCategory ref="UI_Category" />
      <supportedOn ref="SINCE_V1_22" />
      <enabledValue>
        <string>show</string>
