    <policy name="ExitNodesPicker" class="Both" displayName="$(string.ExitNodesPicker)" explainText="$(string.ExitNodesPicker_Help)" key="Software\Policies\TapperVPN" valueName="ExitNodesPicker">
      <parentCategory ref="UI_Category" />
      <supportedOn ref="SINCE_V1_22" />
      <enabledValue>
        <string>show</string>
      </enabledValue>
      <disabledValue>
        <string>hide</string>
      </disabledValue>
