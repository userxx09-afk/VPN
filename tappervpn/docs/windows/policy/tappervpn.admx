    <policy name="OnboardingFlow" class="Both" displayName="$(string.OnboardingFlow)" explainText="$(string.OnboardingFlow_Help)" key="Software\Policies\TapperVPN" valueName="OnboardingFlow">
      <parentCategory ref="UI_Category" />
      <supportedOn ref="SINCE_V1_80" />
      <enabledValue>
        <string>show</string>
      </enabledValue>
      <disabledValue>
        <string>hide</string>
