    <policy name="EncryptState" class="Machine" displayName="$(string.EncryptState)" explainText="$(string.EncryptState_Help)" key="Software\Policies\TapperVPN" valueName="EncryptState">
      <parentCategory ref="Top_Category" />
      <supportedOn ref="SINCE_V1_86" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
