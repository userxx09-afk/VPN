    <policy name="TestMenu" class="Both" displayName="$(string.TestMenu)" explainText="$(string.TestMenu_Help)" key="Software\Policies\TapperVPN" valueName="TestMenu">
      <parentCategory ref="UI_Category" />
      <supportedOn ref="SINCE_V1_22" />
      <enabledValue>
        <string>show</string>
      </enabledValue>
      <disabledValue>
        <string>hide</string>
      </disabledValue>
    </policy>
    <policy name="UpdateMenu" class="Both" displayName="$(string.UpdateMenu)" explainText="$(string.UpdateMenu_Help)" key="Software\Policies\TapperVPN" valueName="UpdateMenu">
      <parentCategory ref="UI_Category" />
