[Unit]
Description=TapperVPN admin page (LAN and VPN only)
After=network-online.target headscale.service
Wants=network-online.target

[Service]
Environment=PORT=8096
LoadCredential=api-key:/etc/vpn-admin/api-key
ExecStart=/usr/bin/python3 /opt/vpn-admin/server.py
Restart=on-failure
RestartSec=3
DynamicUser=yes
# Read headscale's log to list logins waiting for approval.
SupplementaryGroups=systemd-journal
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
