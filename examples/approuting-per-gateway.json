{
  "version": 1,
  "default": "direct",
  "unidentified": "direct",
  "gatewayUnavailable": "block",
  "rules": [
    {
      "name": "Chrome through the Fire TV",
      "action": "gateway",
      "gateway": "shanes-fire-tv-cube",
      "apps": [ { "windows": { "exe": "chrome.exe" } } ]
    },
    {
      "name": "Firefox through the selected exit node",
      "action": "gateway",
      "apps": [ { "windows": { "exe": "firefox.exe" } } ]
    },
    {
      "name": "Block Windows telemetry runner",
      "action": "block",
      "apps": [ { "windows": { "path": "%SystemRoot%\\System32\\CompatTelRunner.exe" } } ]
    }
  ]
}
