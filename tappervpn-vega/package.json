{
  "name": "tappervpn-vega",
  "version": "0.1.0",
  "private": true,
  "description": "TapperVPN for Fire TV on Vega OS",
  "scripts": {
    "start": "react-native start",
    "build:debug": "react-native build-vega --build-type Debug",
    "build:release": "react-native build-vega --build-type Release",
    "build:app": "npm-run-all build:release build:debug",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "bundle": "react-native bundle-vega --build-type Release"
  },
  "dependencies": {
    "@amazon-devices/keplercrypto": "~2.1.4",
    "@amazon-devices/react-native-async-storage__async-storage": "^2.1.9000000000",
    "@amazon-devices/react-native-kepler": "~4.0.0+rn0.83.0",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "~0.22.0",
    "@react-native-community/cli": "^20.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.20.7",
    "@types/react": "^19.1.1",
    "jest": "^29.7.0",
    "npm-run-all": "^4.1.5",
    "ts-jest": "^29.2.0",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "kepler": {
    "projectType": "application",
    "appName": "tappervpn",
    "targets": [
      "tv"
    ]
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
