bin/
node/
toolchain/

# SECRET: Headscale database and private keys. Whoever has these controls the
# network. Back them up somewhere private, never here (this repo is public).
server/data/
server/*.log
*.key
*.jks
*.keystore

# Generated by scripts/build-android.ps1 (go run tappervpn.com/cmd/mkversion)
tappervpn-android/*.version

# Headscale runtime socket (its unix_socket path resolves from the working dir)
data/

# Windows installer build (installer/tappervpn.iss)
dist/
installer/payload/
server/vpn-admin/releases.json
